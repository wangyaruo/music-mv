[
 {
  "start": 32.0,
  "end": 35.9,
  "text": "琥珀色黄昏像糖 在很美的远方",
  "group": 1,
  "idx": 1,
  "dur": 3.9,
  "n": 13
 },
 {
  "start": 35.95,
  "end": 39.687,
  "text": "你的脸没有化妆 我却疯狂爱上",
  "group": 2,
  "idx": 2,
  "dur": 3.737,
  "n": 13
 },
 {
  "start": 39.687,
  "end": 43.4,
  "text": "思念跟影子在傍晚一起被拉长",
  "group": 2,
  "idx": 3,
  "dur": 3.713,
  "n": 13
 },
 {
  "start": 43.85,
  "end": 47.541,
  "text": "我手中那张入场券 陪我数羊",
  "group": 3,
  "idx": 4,
  "dur": 3.691,
  "n": 12
 },
 {
  "start": 47.541,
  "end": 51.591,
  "text": "薄荷色草地芬芳 像风没有形状",
  "group": 3,
  "idx": 5,
  "dur": 4.05,
  "n": 13
 },
 {
  "start": 51.591,
  "end": 55.518,
  "text": "我却能够牢记你的气质跟脸庞",
  "group": 3,
  "idx": 6,
  "dur": 3.927,
  "n": 13
 },
 {
  "start": 55.518,
  "end": 59.9,
  "text": "冷空气跟琉璃在清晨很有透明感",
  "group": 3,
  "idx": 7,
  "dur": 4.382,
  "n": 14
 },
 {
  "start": 60.22,
  "end": 63.863,
  "text": "像我的喜欢 被你看穿",
  "group": 4,
  "idx": 8,
  "dur": 3.643,
  "n": 9
 },
 {
  "start": 63.863,
  "end": 69.754,
  "text": "摊位上一朵艳阳 我悄悄出现你身旁",
  "group": 4,
  "idx": 9,
  "dur": 5.891,
  "n": 15
 },
 {
  "start": 69.754,
  "end": 75.0,
  "text": "你慌乱的模样 我微笑安静欣赏",
  "group": 4,
  "idx": 10,
  "dur": 5.246,
  "n": 13
 },
 {
  "start": 77.77,
  "end": 81.659,
  "text": "我顶着大太阳 只想为你撑伞",
  "group": 5,
  "idx": 11,
  "dur": 3.889,
  "n": 12
 },
 {
  "start": 81.659,
  "end": 85.52,
  "text": "你靠在我肩膀 深呼吸怕遗忘",
  "group": 5,
  "idx": 12,
  "dur": 3.861,
  "n": 12
 },
 {
  "start": 85.62,
  "end": 89.758,
  "text": "因为捞鱼的蠢游戏我们开始交谈",
  "group": 6,
  "idx": 13,
  "dur": 4.138,
  "n": 14
 },
 {
  "start": 89.758,
  "end": 93.931,
  "text": "多希望话题不断 园游会永不打烊",
  "group": 6,
  "idx": 14,
  "dur": 4.173,
  "n": 14
 },
 {
  "start": 93.931,
  "end": 97.367,
  "text": "气球在我手上 我牵着你瞎逛",
  "group": 6,
  "idx": 15,
  "dur": 3.436,
  "n": 12
 },
 {
  "start": 97.367,
  "end": 100.926,
  "text": "有话想对你讲 你眼睛却装忙",
  "group": 6,
  "idx": 16,
  "dur": 3.559,
  "n": 12
 },
 {
  "start": 100.926,
  "end": 105.099,
  "text": "鸡蛋糕跟你嘴角果酱我都想要尝",
  "group": 6,
  "idx": 17,
  "dur": 4.173,
  "n": 14
 },
 {
  "start": 105.099,
  "end": 110.12,
